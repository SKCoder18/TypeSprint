{
  "name": "typesprint",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --webpack",
    "build": "next build --webpack",
    "start": "next start",
    "test": "tsx --test tests/*.test.ts",
    "race:server": "node --env-file-if-exists=.env.local --import tsx server/start.ts",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "start:vinext": "vite preview",
    "deploy:vinext": "vinext-cloudflare deploy"
  },
  "dependencies": {
    "@vinext/cloudflare": "1.3.0",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "react-server-dom-webpack": "19.3.1",
    "vinext": "1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.v.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "6.1.2",
    "@vitejs/plugin-rsc": "0.5.38",
    "cf": "1.0.0-beta.26",
    "postcss": "8.5.32",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5",
    "vite": "8.3.5",
    "vite-css-modules": "1.16.1"
  },
  "type": "module",
  "overrides": {
    "fflate": "0.8.3"
  }
}
